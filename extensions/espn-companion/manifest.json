{
  "manifest_version": 3,
  "name": "The War Room — ESPN Live Sync",
  "version": "0.9.14",
  "description": "Keeps The War Room synchronized with ESPN fantasy football draft picks.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://fantasy.espn.com/*",
    "https://lm-api-reads.fantasy.espn.com/*",
    "https://www.espn.com/fantasy/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://ryan42062001.github.io/The-War-Room/*"
  ],
  "background": {
    "service_worker": "background-entry.js"
  },
  "action": {
    "default_title": "The War Room — ESPN Live Sync",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fantasy.espn.com/*",
        "https://www.espn.com/fantasy/*"
      ],
      "js": [
        "espn-live-capture.js",
        "espn-observability.js",
        "espn-forensic-core.js",
        "espn-forensic-observer.js",
        "espn-click-provenance.js",
        "espn-worker-observer.js",
        "espn-live-observer.js",
        "espn-page-bridge.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://fantasy.espn.com/*",
        "https://www.espn.com/fantasy/*"
      ],
      "js": [
        "espn-forensic-core.js",
        "espn-forensic-content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://fantasy.espn.com/*",
        "https://www.espn.com/fantasy/*"
      ],
      "js": [
        "espn-live-capture.js",
        "espn-api.js",
        "espn-parser.js",
        "espn-content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "https://ryan42062001.github.io/The-War-Room/*"
      ],
      "include_globs": [
        "http://127.0.0.1:8765/*",
        "http://localhost:8765/*",
        "https://ryan42062001.github.io/The-War-Room*"
      ],
      "js": [
        "war-room-content.js",
        "sync-presentation.js",
        "war-room-sync-trust-ui.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
